{
    "sites": {
        "google.com": {
            "check": true,
            "scheme": "https",
            "endpoints": {
                "/": {
                    "status": 200,
                    "dom_contains": "Google"
                },
                "/.well-known/security.txt": {
                    "status": 200,
                    "dom_contains": "security@google.com"
                }
            }
        },
        "localhost:8000": {
            "check": true,
            "scheme": "http",
            "endpoints": {
                "/": {
                    "status": 200,
                    "dom_contains": ""
                }
            },
            "dns_records": [
                {
                    "name": "localhost",
                    "type": "A"
                }
            ]
        }
    }
}
